;;
;; The repo deed of hypatia (one deed per repo, standards#837).
;;
;; Every clause below is translated field for field from a retired A2ML
;; descriptile under the mapping spec that governs its family, in standards
;; 1-formats/deed/mappings/ (the only authority a family translation may cite).
;; A field a table does not list does not translate: it was dropped, not
;; re-homed. docs/history/A2ML-REMOVED.adoc records each removed file, its git
;; blob id and what was dropped from it (owner ruling 2026-11-14, "Full
;; migration now").
;;
;;   CLADE.a2ml      -> (identity) (clade) (forges) (lineage) (status)
;;                      clade-to-repo-deed.adoc. CLADE's [identity] name and
;;                      project repeat canonical-name and are not emitted.
;;                      :repo-uuid is the ADR-008 profile C UUIDv8 re-derived
;;                      from the name (spec section 5, P-1), not the v5 that
;;                      CLADE.a2ml held.
;;   META.a2ml       -> (meta)       meta-ecosystem-to-repo-deed.adoc
;;   ECOSYSTEM.a2ml  -> (ecosystem)  meta-ecosystem-to-repo-deed.adoc
;;   AGENTIC.a2ml    -> (agentic)    agentic-neurosym-playbook-to-repo-deed.adoc
;;   NEUROSYM.a2ml   -> (neurosym)   agentic-neurosym-playbook-to-repo-deed.adoc
;;   PLAYBOOK.a2ml   -> (playbook)   agentic-neurosym-playbook-to-repo-deed.adoc
;;   STATE.a2ml      -> (maturity)   state-v1-decision.adoc, option B (ruled
;;                      2026-11-10): the lifecycle claim is the (status) clause
;;                      above, the maturity a clause of its own
;;                      (vocabulary/maturity.adoc), and the journal is archived,
;;                      not translated.
;;
;; (egress ...) is the standards ADR-009 declaration that RE001 checks: one
;; entry per job that reads a secret other than GITHUB_TOKEN. Each :endpoints
;; list is the job's harden-runner allowed-endpoints, byte for byte, so the
;; two can be compared for equality.
(repo-deed
  :schema-version "1.0.0"
  :canonical-name "hypatia"
  :repo-uuid #u8"gv-clade-index:github.com/hyperpolymath/hypatia"
  :beholding-chora #uuid"0889b37b-defb-831f-973c-e119500db00e"
  (identity :owner "hyperpolymath" :primary-forge github :prefixed-name "ax-hypatia")
  (clade
    :primary ax
    :secondary (sc)
    :assigned "2026-03-16"
    :rationale "")
  (forges
    :github "hyperpolymath/hypatia"
    :gitlab "hyperpolymath/hypatia"
    :bitbucket "hyperpolymath/hypatia")
  (lineage
    :type standalone
    :parent "Neurosymbolic CI/CD intelligence — rule-based scanning"
    :born "2026-03-16")
  (status
    :phase active
    :since "2026-03-16"
    :present #t
    :aliases ()
    :merged-into ""
    :superseded-by ""
    :successors ()
    :ended ""
    (history
      (entry :phase active :since "2026-03-16" :note "backfilled default — correct if the true phase differs")))
  ; STATE.a2ml under state-v1-decision.adoc option B: [project-context]
  ; maturity, the one statal field the (status) clause does not already carry.
  ; The source gave no date, so there is no :since.
  (maturity :level alpha)
  ; META.a2ml: [metadata] last-updated, [maintenance-axes] scoping-first and
  ; the [architecture-decisions] ADRs (id, title, status, date) are the rows
  ; the table lists. Not in the table, so not translated: [metadata] project,
  ; author, license, standard, media-type; [development-practices] (build-tool
  ; is prose, not the SYMBOL the row requires); [maintenance-axes]
  ; priority-order; each ADR's context, decision and consequences.
  (meta
    :last-updated "2026-08-07"
    :scoping-first #t
    (adr :id "ADR-001" :title "Replace Logtalk rule engine with pure Elixir rules" :status accepted :date "2026-04-14")
    (adr :id "ADR-002" :title "Rename VQL→VCL and verisimdb→verisim throughout" :status accepted :date "2026-04-05")
    (adr :id "ADR-003" :title "Route ProofObligations through FleetDispatcher to echidnabot" :status accepted :date "2026-04-11")
    (adr :id "ADR-004" :title "Synthetic rebalancer (Strategy A) as default; B+C deferred to M9" :status accepted :date "2026-04-22")
    (adr :id "ADR-005" :title "Use take_supervised/1 for isolated GenServer tests against Application-supervised processes" :status accepted :date "2026-04-25"))
  ; ECOSYSTEM.a2ml: [metadata] project and ecosystem, [position] type and
  ; purpose. Not translated: [metadata] last-updated and media-type,
  ; [position] category, tier and role, [position.consumers],
  ; [position.producers] and [integration-points] (no table row). The seven
  ; [related-projects] entries are (related) clauses: their relationships
  ; (sibling-standard, data-dependency, dispatch-target, scanner-source,
  ; mcp-host) joined the closed set by owner ruling 2026-11-14 (standards
  ; clauses/ecosystem.abnf v1.1.0), each description is :notes, and the
  ; sibling/infrastructure group names are not carried (the mapping's
  ; grouped-entry row). The source has no [pipeline] section, so there is no
  ; :coordination.
  (ecosystem
    :project "hypatia"
    :ecosystem "hyperpolymath"
    :position-type "component"
    :purpose "Neurosymbolic CI/CD intelligence layer — scans repos via panic-attack, classifies findings through the Safety Triangle, dispatches fixes to gitbot-fleet, learns from outcomes via 5 neural networks."
    (related :name "verification-ecosystem/echidnabot" :relationship sibling-standard :notes "Receives ProofObligation dispatches from Hypatia FleetDispatcher at confidence >= 0.85. Retrain loop feeds back via LearningScheduler N5.")
    (related :name "verification-ecosystem/ephapax" :relationship sibling-standard :notes "Linear-type verifier. Hypatia classifies ephapax-relevant findings and routes to echidnabot for formal verification.")
    (related :name "verification-ecosystem/o" :relationship sibling-standard :notes "Peer verification tool in the verification-ecosystem monorepo.")
    (related :name "nextgen-databases/verisim" :relationship data-dependency :notes "VeriSimDB provides the canonical flat-file store (verisim-data) that Hypatia reads via VCL queries.")
    (related :name "fleet-ecosystem/git-automation-ecosystem/gitbot-fleet" :relationship dispatch-target :notes "7 bots (rhodibot, echidnabot, sustainabot, glambot, seambot, finishbot, panicbot) receive dispatches from FleetDispatcher.")
    (related :name "verification-ecosystem/panic-attack" :relationship scanner-source :notes "panic-attack assail produces JSON AssailReport consumed by Hypatia rules engine. panicbot wraps the CLI.")
    (related :name "boj-server" :relationship mcp-host :notes "All Hypatia MCP capabilities served via BoJ MCP cartridge. No standalone MCP server."))
  ; AGENTIC.a2ml: [metadata] version and last-updated, [agent-permissions]
  ; and the five [maintenance-integrity] axioms the table lists. The source
  ; has no @profile line, so there is no (profile). Not translated:
  ; [agent-constraints] forbidden (an unknown key, which fails closed),
  ; maintenance-integrity completion-claim-requires-behavioural-tests,
  ; [automation-hooks] (lists, not the comment-carried strings the (hooks)
  ; row takes, and each one named a retired .a2ml file), [workflow-pin-
  ; detection], [max-automation] and [sprint-patterns].
  (agentic
    :version "0.2.0"
    :last-updated "2026-08-07"
    (permissions :source #t :tests #t :docs #t :config #t :create-files #t)
    (integrity
      :fail-closed #t
      :require-evidence-per-step #t
      :allow-silent-skip #f
      :require-rerun-after-fix #t
      :release-claim-requires-hard-pass #t))
  ; NEUROSYM.a2ml: [metadata] version and last-updated, [hypatia-config]
  ; scan-enabled, scan-depth and report-format. Not translated:
  ; [hypatia-config] verisim-data-path and fleet-path, and the populated
  ; [neural-config], [symbolic-rules] and [proof-integration] sections,
  ; which fail closed pending table rows.
  (neurosym
    :version "0.2.0"
    :last-updated "2026-08-07"
    (hypatia :scan-enabled #t :scan-depth deep :report-format "json"))
  ; PLAYBOOK.a2ml: [metadata] version and last-updated, and the five
  ; operational sections kept as positions (the family-1 slot doctrine). The
  ; source's sections held runbook content the table has no rows for, so the
  ; content did not translate; nor did [crg-promotion-criteria].
  (playbook
    :version "0.2.0"
    :last-updated "2026-08-07"
    (deployment)
    (incident-response)
    (release-process)
    (docs-format)
    (maintenance-operations))
  ; ANCHOR.a2ml under A7 6.4 (anchor.abnf v2.0.0): its version is
  ; (metadata :version). The source had no authority, which a translator
  ; never invents; the owner supplied it on 2026-11-14: boj-server, written
  ; as boj-server's chora id. That id is boj-server_chora.deed's :repo-uuid
  ; #u8"gv-clade-index:github.com/hyperpolymath/boj-server" (a pre-V9 id,
  ; kept in its gv-clade-index domain), and the registry records the same
  ; uuid_v8 for hyperpolymath/boj-server. Dropped under 6.4: the reverse-DNS
  ; id, clade and status. Not adopted here: the ssg block (META.deed, J29)
  ; and the parents list (ECOSYSTEM.deed (related … :relationship parent),
  ; J26).
  (anchor
    :schema "hyperpolymath.anchor/2"
    :authority "6c7f9305-2a47-8f96-a1ed-bd0940e4d4e6"
    (metadata :version "1.0.0"))
  (egress
    :policy "standards ADR-009"
    (job
      :workflow ".github/workflows/ci-health-sweep.yml"
      :job "sweep"
      :secrets ("HYPATIA_DISPATCH_PAT")
      :endpoints ("github.com:443" "api.github.com:443")
      :enforcement harden-runner-block
      :reason "Checks out this repo, then every call in scripts/ci-health/ is gh against the GitHub API.")
    (job
      :workflow ".github/workflows/estate-rescan.yml"
      :job "preflight"
      :secrets ("HYPATIA_DISPATCH_PAT")
      :endpoints ("api.github.com:443")
      :enforcement harden-runner-block
      :reason "Creates and deletes a probe branch through the GitHub API to prove the token can write before the scan runs.")
    (job
      :workflow ".github/workflows/estate-rescan.yml"
      :job "publish"
      :secrets ("HYPATIA_DISPATCH_PAT")
      :endpoints ("github.com:443" "api.github.com:443" "results-receiver.actions.githubusercontent.com:443" "*.blob.core.windows.net:443")
      :enforcement harden-runner-block
      :reason "Downloads the scan artifact from the artifact service and its blob storage, then pushes the results with git and gh.")
    (job
      :workflow ".github/workflows/hypatia-remediation-sweep.yml"
      :job "sweep"
      :secrets ("HYPATIA_SCAN_PAT" "HYPATIA_DISPATCH_PAT")
      :endpoints ("api.github.com:443" "results-receiver.actions.githubusercontent.com:443" "*.blob.core.windows.net:443")
      :enforcement harden-runner-block
      :reason "Reads vulnerability alerts with the read-only scanner credential, sends repository dispatches with the separate dispatch credential, then uploads the target list as an artifact.")
    (job
      :workflow ".github/workflows/credential-read-check.yml"
      :job "scanner"
      :secrets ("HYPATIA_SCAN_PAT")
      :endpoints ("api.github.com:443")
      :enforcement harden-runner-block
      :reason "Checks token identity and reads one repository's Dependabot alert endpoint without checking out code or printing API bodies.")
    (job
      :workflow ".github/workflows/credential-read-check.yml"
      :job "dispatch"
      :secrets ("HYPATIA_DISPATCH_PAT")
      :endpoints ("api.github.com:443")
      :enforcement harden-runner-block
      :reason "Checks token identity and reads the observation-store main ref; does not validate dispatch or write permissions.")
    (job
      :workflow ".github/workflows/inbox-steward-intake.yml"
      :job "record-report"
      :secrets ("FARM_PAT")
      :endpoints ("github.com:443" "api.github.com:443")
      :enforcement harden-runner-block
      :reason "Checks out this repo, pushes the report branch with git and opens its PR with gh.")
    (job
      :workflow ".github/workflows/inbox-steward-intake.yml"
      :job "analyze-patterns"
      :secrets ("FARM_PAT")
      :endpoints ("github.com:443" "api.github.com:443")
      :enforcement harden-runner-block
      :reason "Checks out this repo without credentials and reads the source repo's merged pull requests through the GitHub API.")
    (job
      :workflow ".github/workflows/inbox-steward-intake.yml"
      :job "update-ruleset"
      :secrets ("FARM_PAT")
      :endpoints ("github.com:443" "api.github.com:443")
      :enforcement harden-runner-block
      :reason "Checks out this repo, pushes the rule-update branch with git and opens its PR with gh.")
    (job
      :workflow ".github/workflows/inbox-steward-intake.yml"
      :job "dispatch-to-farm"
      :secrets ("FARM_PAT")
      :endpoints ("api.github.com:443")
      :enforcement harden-runner-block
      :reason "Sends one repository dispatch to .git-private-farm through the GitHub API.")
    (job
      :workflow ".github/workflows/push-email-notify.yml"
      :job "notify"
      :secrets ("SMTP_HOST" "SMTP_PASS" "SMTP_PORT" "SMTP_USER")
      :endpoints ("github.com:443" "release-assets.githubusercontent.com:443" "objects.githubusercontent.com:443" "secret:SMTP_HOST")
      :enforcement harden-runner-block
      :reason "The action downloads its pinned binary from its GitHub release, then sends the mail by SMTP to the org mail host. The host is itself a secret; harden-runner allows it as SMTP_HOST on SMTP_PORT, else 465.")
    (job
      :workflow ".github/workflows/roadmap-sync.yml"
      :job "sync"
      :secrets ("ROADMAP_SYNC_APP_PRIVATE_KEY")
      :endpoints ("api.github.com:443")
      :enforcement harden-runner-block
      :reason "Mints a GitHub App installation token and syncs the roadmap project; every call goes to the GitHub API.")))
