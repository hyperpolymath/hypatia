#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
set -euo pipefail

[ "${1:-}" = "api" ] || { echo "mock-gh only supports api" >&2; exit 2; }
shift
endpoint="${1:-}"

# Allow-list state: MOCK_STATE is a JSON file holding the repo's current
# selected-actions object. A PUT replaces it (so the read-back is real), unless
# MOCK_SCENARIO=remediate-mismatch, which drops the write to model a concurrent
# change. MOCK_SCENARIO=remediate-unreadable makes the GET fail.
jq_filter=""
args=("$@")
for i in "${!args[@]}"; do
  [ "${args[$i]}" = "--jq" ] && jq_filter="${args[$((i + 1))]}"
done

if grep -q ' -X PUT ' <<<" $* "; then
  body=$(cat)
  if [ -n "${MOCK_STATE:-}" ] && [ "${MOCK_SCENARIO:-}" != "remediate-mismatch" ]; then
    printf '%s\n' "$body" > "$MOCK_STATE"
  fi
  [ -n "${MOCK_PUT_LOG:-}" ] && printf '%s\n' "$body" >> "$MOCK_PUT_LOG"
  exit 0
fi

case "$endpoint" in
  repos/test-owner/test-repo)
    printf 'false\tfalse\n'
    ;;
  'repos/test-owner/test-repo/actions/runs?status=failure&per_page=5')
    printf '101\n'
    ;;
  'repos/test-owner/test-repo/actions/runs/101/jobs?per_page=100')
    printf '201\n'
    ;;
  'repos/test-owner/test-repo/check-runs/201/annotations?per_page=100')
    if [ "${MOCK_SCENARIO:-lockfile}" = "lockfile" ]; then
      # Literal backticks are part of the annotation.
      # shellcheck disable=SC2016
      printf 'Lockfile pin deadbeef for `owner/action` does not match ref `stable`.\n'
    fi
    ;;
  repos/test-owner/test-repo/actions/permissions)
    if [ -n "${MOCK_STATE:-}" ]; then printf 'selected\n'; else printf 'all\n'; fi
    ;;
  repos/test-owner/test-repo/actions/permissions/selected-actions)
    [ "${MOCK_SCENARIO:-}" = "remediate-unreadable" ] && { echo "HTTP 403" >&2; exit 1; }
    state='{"github_owned_allowed":true,"verified_allowed":true,"patterns_allowed":[]}'
    [ -n "${MOCK_STATE:-}" ] && state=$(cat "$MOCK_STATE")
    if [ -n "$jq_filter" ]; then printf '%s' "$state" | jq -r "$jq_filter"; else printf '%s\n' "$state"; fi
    ;;
  'repos/test-owner/test-repo/actions/runs?per_page=30')
    case "${MOCK_SCENARIO:-lockfile}" in
      lockfile) printf '3\t1\n' ;;
      saturated) printf '30\t30\n' ;;
      *) printf '0\t0\n' ;;
    esac
    ;;
  repos/test-owner/test-repo/contents/.github/workflows)
    ;;
  *)
    echo "unexpected mock gh endpoint: $endpoint" >&2
    exit 3
    ;;
esac
