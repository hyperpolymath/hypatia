    "comment": "Where the dashboard artifact goes. The .git-private-farm repo is not readable or writable from the public estate — this is the contract it consumes.",
    "artifact_name": "estate-stats.json",
    "schema_version": "1.0.0",
    "consumer_repo": "hyperpolymath/.git-private-farm",
    "consumer_path": "metadatastician/berrywiki/data/estate-stats.json",
